# SatQuery AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── VLM (TerraQ-VL) Configuration ───────────────────────────────────────────
# Enable/disable the local VLM component
VLM_ENABLED=true

# Path to TerraQ-VL checkpoint (HuggingFace model ID or local path)
# Leave empty to use Gemini-only mode
# Example: VLM_MODEL_PATH=llava-hf/llava-1.5-7b-hf
# Example: VLM_MODEL_PATH=/path/to/terraq-vl-checkpoint
VLM_MODEL_PATH=

# Path to LoRA adapter (optional, loaded on top of base model)
VLM_LORA_PATH=

# Device for VLM inference: auto, cpu, cuda, cuda:0, mps
VLM_DEVICE=auto

# Data type for VLM: auto, float32, float16, bfloat16
VLM_DTYPE=auto

# ─── Google Gemini API ────────────────────────────────────────────────────────
# Get a free API key at: https://aistudio.google.com/apikey
# Free tier: 15 RPM, 1,500 requests/day, 1M TPM
GEMINI_API_KEY=

# Model to use for multimodal reasoning
GEMINI_MODEL=gemini-2.5-flash

# ─── MongoDB Atlas (optional) ─────────────────────────────────────────────────
# Create a free M0 cluster at: https://cloud.mongodb.com
MONGODB_URI=
MONGODB_DATABASE=satquery_ai

# ─── Upload / Request Limits ──────────────────────────────────────────────────
# Maximum file size per image in MB
MAX_UPLOAD_SIZE_MB=50

# Maximum number of images per request
MAX_IMAGES_PER_REQUEST=10

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
# Example: CORS_ORIGINS=http://localhost:5173,https://satquery.example.com
CORS_ORIGINS=*

# ─── BigEarthNet Training ─────────────────────────────────────────────────────
# Root directory of BigEarthNet dataset (for training)
BIGEARTHNET_ROOT=

# Path to metadata.parquet (provided in data/)
BIGEARTHNET_METADATA=data/metadata.parquet
